{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aube",
  "version": "0.1.0",
  "identifier": "com.amritesh.aube",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Aube",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/aube-stt",
      "binaries/aube-notes",
      "binaries/aube-dictate",
      "binaries/aube-diarizer"
    ],
    "resources": {
      "models/diarizer/": "models/diarizer/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
